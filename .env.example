# FoundryVTT Docker Deployment Configuration
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control

# Preferred download method: timed URL from Foundry website (Node.js)
# 1) Go to https://foundryvtt.com/me/licenses
# 2) Set Operating System to Node.js
# 3) Click Timed URL and paste it below
#
# THIS EXPIRES. A running instance never touches it, so it can sit dead for
# months and only fail at the moment you have already wiped the data directory
# and need Foundry reinstalled. Refresh it before any rebuild — it is step zero
# of the drill in docs/FOUNDRY_REBUILD.md.
FOUNDRY_RELEASE_URL=https://your-timed-url-here

# Fallback: Foundry website credentials. Deliberately left EMPTY — refreshing
# the timed URL is the chosen approach, because these would put a Foundry
# account password in this file permanently to save a step taken rarely. Fill
# them only if a rebuild ever has to run unattended, and know what you are
# trading for it.
FOUNDRY_USERNAME=
FOUNDRY_PASSWORD=

# FoundryVTT Configuration
FOUNDRY_ADMIN_KEY=
# Pinned on purpose: a version bump migrates world data on first launch and
# downgrades are unsupported. Move it when you decide to, not when a rebuild
# happens to run. (The image tag :release floats — that is the container's
# tooling, not Foundry.)
#
# This line is the ONLY place the pinned version is written. compose.yml
# requires the variable rather than defaulting it, so an unset version stops the
# stack instead of quietly starting an older Foundry; scripts/validate-template.sh
# fails CI if a default is ever reintroduced.
FOUNDRY_VERSION=14.364
FOUNDRY_TELEMETRY=false

# Performance (both default to true; only set these to override)
# FOUNDRY_MINIFY_STATIC_FILES=true   # compress static assets (maps, tokens, audio)
# FOUNDRY_COMPRESS_WEBSOCKET=true    # compress websocket traffic

# Local compose setup note:
# Either configure this file directly, or run ./deploy-setup.sh for a guided
# setup — it prompts for the same values and writes them here.

# Port Configuration
FOUNDRY_PORT=30000
FOUNDRY_PROXY_PORT=

# Hostname Configuration
FOUNDRY_HOSTNAME=
FOUNDRY_LOCAL_HOSTNAME=

# Data Path
FOUNDRY_DATA_PATH=~/.local/share/FoundryVTT

# Obsidian DnD notes vault. Bind-mounted read-write into the Foundry container
# at /data/Data/DnD so its files appear in Foundry's file picker. Obsidian is
# the source of truth; sync is host-side. Must be writable by the container UID.
DND_VAULT_PATH=~/Documents/DnD

# SSL/HTTPS Configuration (optional)
# FOUNDRY_SSL_CERT=
# FOUNDRY_SSL_KEY=
# FOUNDRY_PROTOCOL=https

# Cloudflare Tunnel (for remote access — no inbound ports required)
# Token from the tunnel you create in the Cloudflare Zero Trust dashboard
# (Networks -> Tunnels). Treat as a live credential — never commit.
# Used only by the compose.cloudflare.yml overlay.
CF_TUNNEL_TOKEN=
# When tunneling, set FOUNDRY_HOSTNAME (above) to the public tunnel hostname,
# e.g. vtt.example.com.

# Container Configuration
CONTAINER_CACHE=/data/container_cache
CONTAINER_CACHE_SIZE=
# CONTAINER_VERBOSE is intentionally absent: the image treats the variable as
# debug-on whenever it is SET (even to "false") and dumps the environment to
# the logs. To debug, add it via a compose.override.yml instead.
CONTAINER_UMASK=

# Optional feature toggles
CAVEMAN_ENABLED=1
CAVEMAN_INSTALL_SHA256=8ddef49c15f089c26affed3c31d97142c683e1d37a1499ae557281ca09c2712c
CAVEMAN_MODE=lite

# ── GitHub auth ───────────────────────────────────────────────────────────────
# Do NOT put a GitHub token here (or in any env var / repo file). Authenticate
# in the container terminal with browser OAuth instead:
#   gh auth login --hostname github.com --git-protocol https --web
# The token lands in gh's config (a named volume outside the workspace), git
# uses it via gh's credential helper, and nothing is readable from the repo.
