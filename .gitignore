# This file specifies intentionally untracked files that Git should ignore.
# Files already tracked by Git are not affected.
# See: https://git-scm.com/docs/gitignore

## DirEnv ##
.envrc

## Environment & Secrets (NEVER commit!) ##
.env
.env.*
!.env.example
.env.local
.env.*.local
secrets.*
*.p12
*.pfx

## Credentials & API Keys ##
cookiejar.json
license.json
*.key
*.pem
*.cert
secret.txt

## FoundryVTT ##
cookiejar.json
license.json

## Foundry MCP server (installed by scripts/setup-mcp.sh) ##
mcp-server/

## Javascript / Typescript ##
dist
node_modules
npm-debug.log*
build
coverage

## Python ##
# The upstream Python suite and src/ tree went with the image-build toolchain
# (a07b482). The only Python left is the battlemap renderer,
# scripts/maps/render_map.py, which has no test suite or packaging of its own —
# so __pycache__ is all that needs ignoring.
__pycache__

## Claude / agent runtime state (template assets in .claude/ stay tracked) ##
.claude/mcp.json
.claude/settings.local.json
.claude/todos/
.claude/cache/
.claude/history/
.claude/statsig/
.claude/worktrees/
.ai/

## Devcontainer / tooling runtime artifacts ##
.gitconfig
.cache/

## Local compose overrides (auto-loaded by Compose v2 next to compose.yml) ##
compose.override.yml

## CI scan outputs (generated by semgrep.yml / container-scan.yml) ##
*.sarif

## OS / editor ##
.DS_Store
.vscode/settings.json

# Foundry content module build output
content/dist/
scripts/content/node_modules/

# Sidebar symlink to the Obsidian notes vault (created at container start)
/DnD

# foundry-base.mjs capture output: one world's enabled modules, written for
# review before promoting entries into foundry-base.json.
/foundry-capture-*.json
